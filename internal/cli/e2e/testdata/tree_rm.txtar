# Subfolder tree listing and recursive removal, matching pass semantics.

exec binpass init --generate-identity

stdin p.txt
exec binpass insert -e work/vpn
stdin p.txt
exec binpass insert -e work/wifi
stdin p.txt
exec binpass insert -e personal/email

# Listing a subfolder shows only that subtree, with the subfolder as heading.
exec binpass ls work
stdout 'work'
stdout 'vpn'
stdout 'wifi'
! stdout 'email'

# find matches across the whole tree.
exec binpass find wifi
stdout 'Search Terms: wifi'
stdout 'wifi'
! stdout 'email'

# Recursive removal deletes the whole subtree.
exec binpass rm -r work
stdout 'removed work/vpn'
stdout 'removed work/wifi'

# Only personal/email remains.
exec binpass ls
stdout 'personal'
! stdout 'work'

-- p.txt --
secret
