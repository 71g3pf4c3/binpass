#!/usr/bin/env bash
# binpass-rofi — a rofi-pass replacement in a few dozen lines.
#
# rofi-pass needs ~900 lines of bash because pass gives it nothing to build on:
# it walks the store itself, parses human-readable output, and drives gpg by
# hand. binpass exposes the same operations natively, so this script only has
# to decide what the user wants done.
#
# Bind it to a key, for example in sway:
#     bindsym $mod+p exec binpass-rofi
# or in i3:
#     bindsym $mod+p exec --no-startup-id binpass-rofi
#
# Requires: rofi, and wtype (Wayland) or xdotool (X11) for the typing actions.
set -euo pipefail

BINPASS=${BINPASS:-binpass}
ROFI_ARGS=(-dmenu -i -no-custom)

# type_text sends a string to the focused window using whichever automation
# tool the session provides.
type_text() {
	if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v wtype >/dev/null; then
		wtype -
	elif command -v xdotool >/dev/null; then
		xdotool type --clearmodifiers --file -
	else
		notify-send "binpass" "install wtype or xdotool to type secrets" 2>/dev/null || true
		exit 1
	fi
}

# --format=plain is the whole point: the picker gets one entry per line
# instead of a tree drawn with box characters.
entry=$("$BINPASS" ls --format=plain | rofi "${ROFI_ARGS[@]}" -p pass) || exit 0
[[ -n $entry ]] || exit 0

action=$(
	printf '%s\n' \
		'copy password' \
		'type password' \
		'type username' \
		'autofill (user, tab, pass)' \
		'copy otp' \
		'copy url' |
		rofi "${ROFI_ARGS[@]}" -p "$entry"
) || exit 0

case $action in
'copy password')
	# The clipboard is cleared and its previous contents restored afterwards.
	"$BINPASS" show --clip "$entry"
	;;
'type password')
	"$BINPASS" show --field=password "$entry" | tr -d '\n' | type_text
	;;
'type username')
	"$BINPASS" show --field=username "$entry" | tr -d '\n' | type_text
	;;
'autofill (user, tab, pass)')
	user=$("$BINPASS" show --field=username "$entry")
	pass=$("$BINPASS" show --field=password "$entry")
	if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v wtype >/dev/null; then
		wtype "$user" -k Tab "$pass" -k Return
	else
		xdotool type --clearmodifiers "$user"
		xdotool key Tab
		xdotool type --clearmodifiers "$pass"
		xdotool key Return
	fi
	;;
'copy otp')
	"$BINPASS" otp --clip "$entry"
	;;
'copy url')
	"$BINPASS" show --field=url --clip "$entry"
	;;
esac
