# D-Bus activation for the binpass Secret Service provider.
#
# A client that asks for org.freedesktop.secrets when nothing owns it causes
# the bus to start this unit, so a program looking for the keyring finds one
# without the user having started anything by hand.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/usr/bin/binpass ss serve
SystemdService=binpass-ss.service
