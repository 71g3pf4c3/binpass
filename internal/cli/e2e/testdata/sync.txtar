# Two-device synchronisation through a shared directory remote.
# Device A and B share one identity (same owner) and one remote path.

# Device A: init, insert, push.
env BINPASS_STORE_DIR=$WORK/storeA
env XDG_CONFIG_HOME=$WORK/configA
exec binpass init --generate-identity
stdin p.txt
exec binpass insert -e github.com/alice
exec binpass sync --path $WORK/remote
stdout 'pushed 1'

# Device B: same identity + recipients, then pull.
env BINPASS_STORE_DIR=$WORK/storeB
env XDG_CONFIG_HOME=$WORK/configB
mkdir $WORK/configB/binpass
mkdir $WORK/storeB
exec cp $WORK/configA/binpass/identities.age $WORK/configB/binpass/identities.age
exec cp $WORK/storeA/.age-recipients $WORK/storeB/.age-recipients
exec binpass sync --path $WORK/remote
stdout 'pulled 1'

# B can read the secret A created.
exec binpass show github.com/alice
stdout 'hunterA'

-- p.txt --
hunterA
