# Core lifecycle of a store: init, insert, show, list.

# An uninitialised store refuses to do anything, with pass's own wording.
! binpass ls
stderr 'password store is empty'

binpass init --age $RECIPIENT
stdout 'Password store initialized'
exists $WORK/store/.age-recipients

# Insert reads the entry from stdin with --multiline.
stdin entry.txt
binpass insert -m github.com/alice
exists $WORK/store/github.com/alice.age

# Show prints the plaintext back, byte for byte.
binpass show github.com/alice
cmp stdout entry.txt

# A bare name is a show, exactly as in pass.
binpass github.com/alice
cmp stdout entry.txt

# Individual fields can be pulled out without the rest of the entry.
binpass show --field=username github.com/alice
stdout '^alice$'

binpass show --field=password github.com/alice
stdout '^hunter2$'

! binpass show --field=missing github.com/alice
stderr 'no field'

# The ciphertext must not contain the secret.
! grep 'hunter2' $WORK/store/github.com/alice.age

-- entry.txt --
hunter2
username: alice
url: https://github.com
