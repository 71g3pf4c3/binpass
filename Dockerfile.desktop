# Desktop integration image for binpass.
#
# The clipboard backends (xclip, xsel) and the X11 typing path (xdotool)
# are only PATH-stub tested in the unit suite: the stubs prove where the
# secret travels, not that a real X server accepts the arguments. This
# image is where they meet the real tools on a real Xvfb display.
#
#   docker build -f Dockerfile.desktop -t binpass-desktop .
#   docker run --rm binpass-desktop
#
# The Wayland halves (wl-copy, wtype) are out of scope here: they need a
# compositor, and running one is what Dockerfile.e2e already does with sway.
#
# The base image is pinned by digest: `golang:1.26-trixie` is a moving tag,
# so the toolchain and the X11 packages this suite exercises would otherwise
# change under the test without a commit. The tag stays in the comment so a
# bump is a readable diff (resolve the new digest from the registry, e.g.
# `skopeo inspect --raw docker://docker.io/library/golang:1.26-trixie`).
FROM golang:1.26-trixie@sha256:f06b7122f888680048afb247c4e5f49c0069eb6c4c1ccae0f3f4834527a8d22c

RUN apt-get update && apt-get install -y --no-install-recommends \
	xvfb \
	xdotool \
	xclip \
	xsel \
	xterm \
	xfonts-base \
	dmenu \
	fonts-dejavu-core \
	age \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ENV CGO_ENABLED=0
ENV BINPASS_CONFIG=/nonexistent.yaml

COPY scripts/desktop-session.sh /usr/local/bin/desktop-session.sh

CMD ["bash", "/usr/local/bin/desktop-session.sh"]
